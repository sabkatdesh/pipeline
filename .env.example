# Copy to .env and fill in ANTHROPIC_API_KEY. Never commit .env.

# ── Database (compose overrides the host to "db" automatically) ─────────────
DB_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://pipeline:password@localhost:5432/pipeline

# ── LLM: Anthropic (required for /ask answers and concept extraction) ───────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024

# ── Embeddings ──────────────────────────────────────────────────────────────
# local  (default): fastembed/ONNX, no key, downloads ~90 MB on first use.
# openai | azure : change EMBEDDING_DIM to match (1536 for text-embedding-3-small)
#                  and re-create the DB volume (docker compose down -v).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=100

# ── Optional: Azure OpenAI (embeddings via EMBEDDING_PROVIDER=azure, or chat
#    fallback when ANTHROPIC_API_KEY is empty) ────────────────────────────────
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# OPENAI_API_KEY=   (only for EMBEDDING_PROVIDER=openai)

# ── RAG ─────────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30   # best cosine similarity below this => "no match"
RAG_MEDIUM_THRESHOLD=0.45
RAG_HIGH_THRESHOLD=0.60
RAG_MAX_RETRY_ITERATIONS=2

# ── Ingestion ───────────────────────────────────────────────────────────────
ARXIV_RATE_LIMIT_SECONDS=3.5
ARXIV_BATCH_SIZE=500
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_MAX_PAPERS=3500
INGEST_DATE_FROM=2026-01-01
INGEST_DATE_TO=2026-09-29
CONCEPT_EXTRACTION_BATCH_SIZE=20

# ── API ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RESET_CONFIRMATION_TOKEN=change-me
