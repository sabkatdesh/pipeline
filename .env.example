# ── Example .env (copy this to .env and fill secrets) ─────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pipeline:password@db:5432/pipeline
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_PASSWORD=password

# ── Embedding ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai          # openai | local
OPENAI_API_KEY=sk-...              # required when EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                 # 1536 for openai, 384 for local

# Azure OpenAI / Foundry (optional)
AZURE_OPENAI_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2023-10-01-preview

# ── LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024

# ── RAG ──────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_RETRY_ITERATIONS=3
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_BM25_INDEX_PATH=/app/data/bm25_index.pkl
RAG_GRAPH_PATH=/app/data/concept_graph.pkl

# ── Ingestion ────────────────────────────────────────────────────────────
ARXIV_RATE_LIMIT_SECONDS=3.5
ARXIV_BATCH_SIZE=500
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_MAX_PAPERS=3500
INGEST_DATE_FROM=2026-01-01
INGEST_DATE_TO=2026-09-29
EMBEDDING_BATCH_SIZE=100
CONCEPT_EXTRACTION_BATCH_SIZE=20

# ── API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
RESET_CONFIRMATION_TOKEN=my-secret-reset-token
